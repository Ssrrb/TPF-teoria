@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
left to right direction
title Diagrama de Entidad Relación

hide circle
skinparam linetype ortho

entity "organizacion" as organizacion {
  * id : UUID <<PK>>
  --
  * nombre : VARCHAR(160)
  * pais : CHAR(2)
  * moneda : CHAR(3)
}
entity "usuario" as usuario {
  * id : UUID <<PK>>
  --
  * nombre : VARCHAR(160)
  * email : VARCHAR(254)
  * organizacion_id : UUID <<FK>>
}
entity "rol_asignado" as rol_asignado {
  * usuario_id : UUID <<PK, FK>>
  * obra_id : UUID <<PK, FK>>
  --
  * rol : VARCHAR(40)
  * vigenteDesde : DATE
}
entity "cliente" as cliente {
  * id : UUID <<PK>>
  --
  * formaLegal : VARCHAR(10)
  * identificador : VARCHAR(30)
  * nombre : VARCHAR(160)
}
entity "socio" as socio {
  * id : UUID <<PK>>
  --
  * formaLegal : VARCHAR(10)
  * identificador : VARCHAR(30)
  * nombre : VARCHAR(160)
}
entity "obra" as obra {
  * id : UUID <<PK>>
  --
  * codigo : VARCHAR(30)
  * nombre : VARCHAR(160)
  * direccion : VARCHAR(240)
  * estado : VARCHAR(20)
  * fechaInicio : DATE
  * fechaFin : DATE
  * organizacion_id : UUID <<FK>>
  * cliente_id : UUID <<FK>>
}
entity "configuracion_obra" as configuracion_obra {
  * id : UUID <<PK>>
  --
  * tasaIVA : NUMERIC(5,2)
  * moneda : CHAR(3)
  * toleranciaDesvio : NUMERIC(5,2)
  * obra_id : UUID <<FK>>
}
entity "fondo_retencion" as fondo_retencion {
  * id : UUID <<PK>>
  --
  * nombre : VARCHAR(80)
  * porcentaje : NUMERIC(5,2)
  * base : VARCHAR(20)
  * aplicaA : VARCHAR(20)
  * activo : BOOLEAN
  * configuracion_obra_id : UUID <<FK>>
}
entity "presupuesto" as presupuesto {
  * id : UUID <<PK>>
  --
  * tipo : VARCHAR(10)
  * moneda : CHAR(3)
  * obra_id : UUID <<FK>>
}
entity "version_presupuesto" as version_presupuesto {
  * id : UUID <<PK>>
  --
  * numero : INTEGER
  * estado : VARCHAR(20)
  * fechaActivacion : TIMESTAMPTZ
  * presupuesto_id : UUID <<FK>>
}
entity "linea_presupuesto" as linea_presupuesto {
  * id : UUID <<PK>>
  --
  * codigo : VARCHAR(40)
  * descripcion : VARCHAR(400)
  * tipo : VARCHAR(12)
  * unidad : VARCHAR(12)
  * cantidad : NUMERIC(24,12)
  * precioUnitario : NUMERIC(24,12)
  * orden : INTEGER
  * version_presupuesto_id : UUID <<FK>>
    padre_id : UUID <<FK>>
    acu_id : UUID <<FK>>
}
entity "archivo_origen" as archivo_origen {
  * id : UUID <<PK>>
  --
  * nombre : VARCHAR(255)
  * hashSHA256 : CHAR(64)
  * ruta : VARCHAR(500)
  * fechaCarga : TIMESTAMPTZ
  * version_presupuesto_id : UUID <<FK>>
}
entity "informe_importacion" as informe_importacion {
  * id : UUID <<PK>>
  --
  * totalDeclarado : NUMERIC(24,12)
  * totalRecalculado : NUMERIC(24,12)
  * tolerancia : NUMERIC(24,12)
  * cuadra : BOOLEAN
  * version_presupuesto_id : UUID <<FK>>
}
entity "analisis_costo_unitario" as analisis_costo_unitario {
  * id : UUID <<PK>>
  --
  * codigo : VARCHAR(40)
  * descripcion : VARCHAR(400)
  * unidad : VARCHAR(12)
  * estado : VARCHAR(12)
  * obra_id : UUID <<FK>>
}
entity "componente_acu" as componente_acu {
  * id : UUID <<PK>>
  --
  * via : VARCHAR(12)
  * descripcion : VARCHAR(240)
  * unidad : VARCHAR(12)
  * cantidad : NUMERIC(24,12)
  * precioUnitario : NUMERIC(24,12)
  * factorCargas : NUMERIC(5,2)
  * acu_id : UUID <<FK>>
}
entity "periodo" as periodo {
  * id : UUID <<PK>>
  --
  * numero : INTEGER
  * fechaInicio : DATE
  * fechaFin : DATE
  * estado : VARCHAR(12)
  * obra_id : UUID <<FK>>
}
entity "medicion_oficial" as medicion_oficial {
  * id : UUID <<PK>>
  --
  * cantidad : NUMERIC(24,12)
  * unidad : VARCHAR(12)
  * ejecutor : VARCHAR(16)
  * estado : VARCHAR(12)
  * fechaRegistro : TIMESTAMPTZ
  * fechaDecision : TIMESTAMPTZ
  * motivoRechazo : VARCHAR(400)
  * periodo_id : UUID <<FK>>
  * linea_presupuesto_id : UUID <<FK>>
  * version_presupuesto_id : UUID <<FK>>
  * registrado_por : UUID <<FK>>
    decidido_por : UUID <<FK>>
}
entity "evidencia" as evidencia {
  * id : UUID <<PK>>
  --
  * nombre : VARCHAR(255)
  * tipo : VARCHAR(20)
  * ruta : VARCHAR(500)
  * fechaCarga : TIMESTAMPTZ
  * medicion_oficial_id : UUID <<FK>>
}
entity "propuesta_pendiente" as propuesta_pendiente {
  * id : UUID <<PK>>
  --
  * cantidad : NUMERIC(24,12)
  * estado : VARCHAR(12)
  * fechaRegistro : TIMESTAMPTZ
  * medicion_oficial_id : UUID <<FK>>
    movimiento_id : UUID <<FK>>
}
entity "movimiento_presupuestario" as movimiento_presupuestario {
  * id : UUID <<PK>>
  --
  * tipo : VARCHAR(20)
  * motivo : VARCHAR(400)
  * montoEfecto : NUMERIC(24,12)
  * limite : NUMERIC(24,12)
  * estado : VARCHAR(24)
  * fechaPropuesta : TIMESTAMPTZ
  * linea_presupuesto_id : UUID <<FK>>
    version_generada_id : UUID <<FK>>
}
entity "certificado" as certificado {
  * id : UUID <<PK>>
  --
  * numero : VARCHAR(30)
  * tipo : VARCHAR(16)
  * fechaEmision : DATE
  * destinatario : VARCHAR(160)
  * estado : VARCHAR(12)
  * periodo_id : UUID <<FK>>
    subcontrato_id : UUID <<FK>>
    emitido_por : UUID <<FK>>
}
entity "revision_certificado" as revision_certificado {
  * id : UUID <<PK>>
  --
  * numero : INTEGER
  * fechaGeneracion : TIMESTAMPTZ
  * subtotal : NUMERIC(24,12)
  * certificado_id : UUID <<FK>>
}
entity "linea_certificado" as linea_certificado {
  * id : UUID <<PK>>
  --
  * cantidadPeriodo : NUMERIC(24,12)
  * precioUnitario : NUMERIC(24,12)
  * revision_certificado_id : UUID <<FK>>
  * medicion_oficial_id : UUID <<FK>>
  * linea_presupuesto_id : UUID <<FK>>
}
entity "aprobacion" as aprobacion {
  * id : UUID <<PK>>
  --
  * tipo : VARCHAR(24)
  * fecha : TIMESTAMPTZ
  * observacion : VARCHAR(400)
    movimiento_id : UUID <<FK>>
  * actor_id : UUID <<FK>>
}
entity "retencion_aplicada" as retencion_aplicada {
  * id : UUID <<PK>>
  --
  * porcentaje : NUMERIC(5,2)
  * base : NUMERIC(24,12)
  * revision_certificado_id : UUID <<FK>>
  * fondo_retencion_id : UUID <<FK>>
}
entity "subcontrato" as subcontrato {
  * id : UUID <<PK>>
  --
  * numero : VARCHAR(30)
  * montoContrato : NUMERIC(24,12)
  * modalidad : VARCHAR(16)
  * estado : VARCHAR(12)
  * obra_id : UUID <<FK>>
  * socio_id : UUID <<FK>>
}
entity "documento_financiero_erp" as documento_financiero_erp {
  * id : UUID <<PK>>
  --
  * tipo : VARCHAR(12)
  * numero : VARCHAR(30)
  * fecha : DATE
  * monto : NUMERIC(24,12)
  * estado : VARCHAR(12)
  * certificado_id : UUID <<FK>>
}
entity "registro_auditoria" as registro_auditoria {
  * id : UUID <<PK>>
  --
  * entidad : VARCHAR(60)
  * entidadId : UUID
  * accion : VARCHAR(40)
  * fecha : TIMESTAMPTZ
  * detalle : VARCHAR(600)
  * actor_id : UUID <<FK>>
}

organizacion ||--o{ obra
organizacion ||--|{ usuario
usuario ||--o{ rol_asignado
obra ||--o{ rol_asignado
cliente ||--o{ obra : comitente
obra ||--|| configuracion_obra
configuracion_obra ||--o{ fondo_retencion
obra ||--|{ presupuesto
presupuesto ||--|{ version_presupuesto
version_presupuesto ||--|{ linea_presupuesto
linea_presupuesto |o--o{ linea_presupuesto : jerarquía rubro/subrubro/ítem
version_presupuesto ||--o| archivo_origen
version_presupuesto ||--o| informe_importacion
analisis_costo_unitario |o--o{ linea_presupuesto
analisis_costo_unitario ||--|{ componente_acu
obra ||--o{ analisis_costo_unitario
obra ||--o{ periodo
periodo ||--o{ medicion_oficial
linea_presupuesto ||--o{ medicion_oficial
version_presupuesto ||--o{ medicion_oficial : medida contra
usuario ||--o{ medicion_oficial : registra
usuario |o--o{ medicion_oficial : aprueba o rechaza
medicion_oficial ||--o{ evidencia
medicion_oficial ||--o| propuesta_pendiente
movimiento_presupuestario |o--o{ propuesta_pendiente : cubre
linea_presupuesto ||--o{ movimiento_presupuestario : objetivo
version_presupuesto |o--o{ movimiento_presupuestario : genera
periodo ||--o{ certificado
subcontrato |o--o{ certificado
certificado ||--|{ revision_certificado
revision_certificado ||--|{ linea_certificado
medicion_oficial ||--o| linea_certificado
linea_presupuesto ||--o{ linea_certificado
usuario |o--o{ certificado : emite
movimiento_presupuestario |o--o{ aprobacion
usuario ||--o{ aprobacion
revision_certificado ||--o{ retencion_aplicada
fondo_retencion ||--o{ retencion_aplicada
certificado ||--o| documento_financiero_erp
obra ||--o{ subcontrato
socio ||--o{ subcontrato
usuario ||--o{ registro_auditoria
@enduml