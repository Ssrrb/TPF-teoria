@startuml
left to right direction
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam nodesep 20
skinparam ranksep 80
title Sistema Obra Studio — Casos de Uso de Alto Nivel

actor "Ingeniero de Obra" as ING
actor "Responsable Técnico" as SUP
actor "Administrador" as ADM
actor "Subcontratista" as SUB

rectangle "Obra Studio" {
  usecase "Presupuesto y Medición" as SUB_A
  usecase "Certificación y Subcontratos" as SUB_B
}

actor "Cliente" as CLI
actor "Motor de Ingeniería" as ECMS
actor "Motor ERP" as ERP
actor "Finanzas y Tesorería" as TES

ING --> SUB_A
SUP --> SUB_A
ADM --> SUB_A
SUB_A --> CLI
SUB_A --> ECMS
ING --> SUB_B
SUP --> SUB_B
ADM --> SUB_B
SUB --> SUB_B
SUB_B --> CLI
SUB_B --> ECMS
SUB_B --> ERP
SUB_B --> TES
@enduml