@startuml
left to right direction
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 60
title Sistema Obra Studio — Subsistema Certificación y Subcontratos

actor "Ingeniero de Obra" as ING
actor "Responsable Técnico" as SUP
actor "Administrador" as ADM
actor "Subcontratista" as SUB

rectangle "Certificación y Subcontratos" {
  usecase "CU-07\nGenerar borrador de certificado" as CU_07
  usecase "CU-08\nCorregir certificado emitido" as CU_08
  usecase "CU-09\nEmitir certificado de avance" as CU_09
  usecase "CU-10\nDerivar documento financiero en ERP" as CU_10
  usecase "CU-12\nRegistrar contrato de subcontrato" as CU_12
  usecase "CU-13\nPresentar medición de subcontrato" as CU_13
  usecase "CU-14\nCertificar y valorizar subcontrato" as CU_14
  usecase "CU-16\nConsultar reportes y Curva S" as CU_16
}

actor "Motor de Ingeniería" as ECMS
actor "Sistema ERP" as ERP
actor "Finanzas y Tesorería" as TES

ING --> CU_07
ING --> CU_08
ING --> CU_09
ADM --> CU_09
CU_10 --> ECMS
CU_10 --> ERP
CU_10 --> TES
ADM --> CU_12
SUB --> CU_13
SUP --> CU_14
SUB --> CU_14
CU_14 --> ERP
ADM --> CU_16
SUP --> CU_16

CU_09 ..> CU_10 : <<include>>
CU_14 ..> CU_10 : <<include>>
@enduml