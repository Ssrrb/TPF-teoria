@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
title Estados de MovimientoPresupuestario

state "Propuesto" as Propuesto
Propuesto : Registrado con tipo, objetivo, motivo y respaldo documental.
state "AprobadoInterno" as AprobadoInterno
AprobadoInterno : La organización lo aprobó; todavía no modifica el presupuesto.
state "AprobadoContractual" as AprobadoContractual
AprobadoContractual : El comitente lo aceptó; habilita la nueva versión.
state "Vigente" as Vigente
Vigente : Generó una versión de presupuesto nueva que ya rige.
state "Rechazado" as Rechazado
Rechazado : No prosperó; el presupuesto vigente no cambia.

[*] --> Propuesto
Propuesto --> AprobadoInterno : aprobar internamente [datos completos y dentro del límite]
Propuesto --> Rechazado : rechazar
AprobadoInterno --> AprobadoContractual : aprobar contractualmente
AprobadoInterno --> Rechazado : rechazar
AprobadoContractual --> Vigente : activar versión
Vigente --> [*]
Rechazado --> [*]
@enduml