@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam sequenceMessageAlign left
title Caso de Uso CU-09 — Emitir certificado de avance

actor "Ingeniero de Obra" as ING
participant "<<Boundary>>\nEmitirCertificadoControlador" as CTRL
participant "<<Control>>\nEmitirCertificadoInteractor" as UC
participant "<<Control>>\nCalcularValorizacionServicio" as VLZ
participant "<<Interface>>\nICertificadoRepositorio" as CREP
participant "<<Interface>>\nIGeneradorDocumento" as DOC
participant "<<Interface>>\nIPublicadorEventos" as EVT
participant "<<Entity>>\nCertificado" as CER

ING -> CTRL : abrirRevision(revisionId)
activate CTRL
CTRL -> UC : obtenerRevision(revisionId)
activate UC
UC -> CREP : buscarRevision(revisionId)
activate CREP
CREP --> UC : RevisionCertificado
deactivate CREP
UC -> VLZ : calcular(lineas, configuracionObra)
activate VLZ
VLZ --> UC : Valorizacion(subtotal, impuestos, retenciones, total)
deactivate VLZ
UC --> CTRL : revisión con valorización y alertas
deactivate UC
CTRL --> ING : muestra cantidades, valorización y alertas
deactivate CTRL
ING -> CTRL : emitirCertificado(revisionId, destinatario)
activate CTRL
CTRL -> UC : emitir(revisionId, destinatario, actorId)
activate UC
UC -> CREP : siguienteNumero(obraId)
activate CREP
CREP --> UC : numero
deactivate CREP
UC -> CER : emitir(numero, fecha, destinatario, actorId)
activate CER
UC -> CREP : guardar(certificado)
activate CREP
UC -> DOC : exportar(revision, formato)
activate DOC
DOC --> UC : archivo nuevo XLSX o PDF
deactivate DOC
UC ->> EVT : publicar(CertificadoEmitido(certificadoId))
deactivate CREP
deactivate CER
UC --> CTRL : resultado de la emisión
deactivate UC
CTRL --> ING : confirma número, fecha y archivo generado
deactivate CTRL
@enduml