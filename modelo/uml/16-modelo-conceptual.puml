@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam nodesep 40
skinparam ranksep 70
hide circle
hide members
left to right direction
skinparam classBackgroundColor #FFFFFF
title Modelo Conceptual — Obra Studio

class Organizacion
class Usuario
class Cliente
class Socio
class Obra
class Presupuesto
class VersionPresupuesto
class LineaPresupuesto
class Periodo
class MedicionOficial
class MovimientoPresupuestario
class Certificado
class Subcontrato

Organizacion "1" o-- "0..*" Obra
Organizacion "1" o-- "1..*" Usuario
Cliente "1" -- "0..*" Obra : comitente
Obra "1" *-- "1..*" Presupuesto
Presupuesto "1" *-- "1..*" VersionPresupuesto
VersionPresupuesto "1" *-- "1..*" LineaPresupuesto
LineaPresupuesto "0..1" -- "0..*" LineaPresupuesto : jerarquía rubro/subrubro/ítem
Obra "1" *-- "0..*" Periodo
Periodo "1" *-- "0..*" MedicionOficial
LineaPresupuesto "1" -- "0..*" MedicionOficial
VersionPresupuesto "1" -- "0..*" MedicionOficial : medida contra
LineaPresupuesto "1" -- "0..*" MovimientoPresupuestario : objetivo
VersionPresupuesto "0..1" -- "0..*" MovimientoPresupuestario : genera
Periodo "1" -- "0..*" Certificado
Subcontrato "0..1" -- "0..*" Certificado
Obra "1" o-- "0..*" Subcontrato
Socio "1" -- "0..*" Subcontrato
@enduml