@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 45
hide circle
title Caso de Uso CU-05 — Aprobar o rechazar medición oficial

package "Adaptadores de interfaz" <<Rectangle>> {
  class AprobarMedicionControlador <<Boundary>> {
    +listarMediciones(obraId, periodoId)
    +aprobarMedicion(medicionId)
  }
  class MedicionPresentador <<Boundary>> {
    
  }
}
package "Casos de uso" <<Rectangle>> {
  class AprobarMedicionInteractor <<Control>> {
    +obtenerPendientes(periodoId)
    +ejecutar(medicionId, actorId)
  }
  class EvaluarSaldoServicio <<Control>> {
    +evaluar(cantidadMedida, saldo)
  }
}
package "Dominio" <<Rectangle>> {
  class Periodo <<Entity>> {
  +id : UUID
  -numero : Integer
  -fechaInicio : Date
  -fechaFin : Date
  -...
  }
  class MedicionOficial <<Entity>> {
  +id : UUID
  -cantidad : Decimal
  -unidad : String
  -ejecutor : String
  -/cantidadCertificable : Decimal
  -...
    --
    +aprobar(cantidadCertificable, actorId, fecha)
    +aprobar(cantidadMedida, actorId, fecha)
  }
  class Evidencia <<Entity>> {
  +id : UUID
  -nombre : String
  -tipo : String
  -ruta : String
  -...
  }
  class LineaPresupuesto <<Entity>> {
  +id : UUID
  -codigo : String
  -descripcion : String
  -tipo : String
  -/importe : Decimal
  -/cantidadMedida : Decimal
  -/saldo : Decimal
  -...
    --
    +saldo(cantidadAcumulada)
  }
  class VersionPresupuesto <<Entity>> {
  +id : UUID
  -numero : Integer
  -estado : String
  -fechaActivacion : DateTime
  -/montoContractual : Decimal
  }
  class PropuestaPendiente <<Entity>> {
  +id : UUID
  -cantidad : Decimal
  -estado : String
  -causa : String
  -...
    --
    +crear(exceso, estado = Pendiente)
  }
  interface IMedicionRepositorio <<Interface>> {
  +listarPorPeriodo(periodoId)
  +guardar(medicion)
  +acumuladoAprobado(lineaId)
  }
  interface IPresupuestoRepositorio <<Interface>> {
  +buscarVersionVigente(obraId)
  }
  interface IAuditoriaRepositorio <<Interface>> {
  +registrar(entrada)
  }
  interface IReloj <<Interface>> {
  +ahora()
  }
}

AprobarMedicionControlador --> AprobarMedicionInteractor
AprobarMedicionInteractor --> EvaluarSaldoServicio
AprobarMedicionInteractor ..> MedicionPresentador
AprobarMedicionInteractor ..> IMedicionRepositorio
AprobarMedicionInteractor ..> IPresupuestoRepositorio
AprobarMedicionInteractor ..> IAuditoriaRepositorio
AprobarMedicionInteractor ..> IReloj
AprobarMedicionInteractor ..> Periodo
VersionPresupuesto "1" *-- "1..*" LineaPresupuesto
LineaPresupuesto "0..1" -- "0..*" LineaPresupuesto
Periodo "1" *-- "0..*" MedicionOficial
LineaPresupuesto "1" -- "0..*" MedicionOficial
VersionPresupuesto "1" -- "0..*" MedicionOficial
MedicionOficial "1" *-- "0..*" Evidencia
MedicionOficial "1" *-- "0..1" PropuestaPendiente

note as NInfra
  La infraestructura implementa cada puerto del dominio.
  Esa realización se documenta en la vista de componentes C4.
end note
@enduml