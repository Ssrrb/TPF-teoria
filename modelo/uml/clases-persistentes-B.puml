@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 50
hide circle
title Clases Persistentes (B) — Medición y certificación

package "Medición" <<Rectangle>> {
  class Periodo <<persistent>> {
  +id : UUID
  -numero : Integer
  -fechaInicio : Date
  -fechaFin : Date
  -...
  }
  class MedicionOficial <<persistent>> {
  +id : UUID
  -cantidad : Decimal
  -unidad : String
  -ejecutor : String
  -/cantidadCertificable : Decimal
  -...
  }
  class Evidencia <<persistent>> {
  +id : UUID
  -nombre : String
  -tipo : String
  -ruta : String
  -...
  }
  class PropuestaPendiente <<persistent>> {
  +id : UUID
  -cantidad : Decimal
  -estado : String
  -causa : String
  -...
  }
}
package "Certificación" <<Rectangle>> {
  class Certificado <<persistent>> {
  +id : UUID
  -numero : String
  -tipo : String
  -fechaEmision : Date
  -...
  }
  class RevisionCertificado <<persistent>> {
  +id : UUID
  -numero : Integer
  -fechaGeneracion : DateTime
  -subtotal : Decimal
  -/impuestos : Decimal
  -/retenciones : Decimal
  -/total : Decimal
  }
  class LineaCertificado <<persistent>> {
  +id : UUID
  -cantidadPeriodo : Decimal
  -precioUnitario : Decimal
  -/importe : Decimal
  -/cantidadAcumulada : Decimal
  }
  class Aprobacion <<persistent>> {
  +id : UUID
  -tipo : String
  -fecha : DateTime
  -observacion : String
  }
  class RetencionAplicada <<persistent>> {
  +id : UUID
  -porcentaje : Decimal
  -base : Decimal
  -/importe : Decimal
  }
}
package "Subcontratos e integración ERP" <<Rectangle>> {
  class Subcontrato <<persistent>> {
  +id : UUID
  -numero : String
  -montoContrato : Decimal
  -modalidad : String
  -/montoCertificado : Decimal
  -/saldoCertificable : Decimal
  -...
  }
  class DocumentoFinancieroERP <<persistent>> {
  +id : UUID
  -tipo : String
  -numero : String
  -fecha : Date
  -...
  }
}
package "De otra figura" <<Rectangle>> {
  class Obra <<referencia>>
  class LineaPresupuesto <<referencia>>
  class VersionPresupuesto <<referencia>>
  class MovimientoPresupuestario <<referencia>>
  class FondoRetencion <<referencia>>
  class Socio <<referencia>>
}
Obra "1" *-- "0..*" Periodo
Periodo "1" *-- "0..*" MedicionOficial
LineaPresupuesto "1" -- "0..*" MedicionOficial
VersionPresupuesto "1" -- "0..*" MedicionOficial
MedicionOficial "1" *-- "0..*" Evidencia
MedicionOficial "1" *-- "0..1" PropuestaPendiente
MovimientoPresupuestario "0..1" -- "0..*" PropuestaPendiente
Periodo "1" -- "0..*" Certificado
Subcontrato "0..1" -- "0..*" Certificado
Certificado "1" *-- "1..*" RevisionCertificado
RevisionCertificado "1" *-- "1..*" LineaCertificado
MedicionOficial "1" -- "0..1" LineaCertificado
LineaPresupuesto "1" -- "0..*" LineaCertificado
MovimientoPresupuestario "0..1" *-- "0..*" Aprobacion
RevisionCertificado "1" *-- "0..*" RetencionAplicada
FondoRetencion "1" -- "0..*" RetencionAplicada
Certificado "1" -- "0..1" DocumentoFinancieroERP
Obra "1" o-- "0..*" Subcontrato
Socio "1" -- "0..*" Subcontrato

note as NDeriv
  Los atributos con / son derivados: se calculan desde
  los registros aprobados y no se almacenan.
  Los puntos suspensivos indican atributos elididos; el
  detalle completo de columnas está en el diagrama de
  entidad relación.
  Las clases <<referencia>> se detallan en la otra figura.
end note
@enduml