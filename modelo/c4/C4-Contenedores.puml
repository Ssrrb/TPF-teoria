@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Contenedores — Obra Studio

Person(ING, "Ingeniero de Obra", "Carga el presupuesto y el cronograma de la obra, registra la medición oficial de cada ítem del período con su evidencia, genera y emite los certificados de avance y los corrige.")
Person(SUP, "Responsable Técnico", "Supervisor de la obra.")
Person(ADM, "Administrador", "Gerente de la obra.")
Person(SUB, "Subcontratista", "Consulta el estado de sus mediciones, certificados, valorizaciones y saldos.")
Person(CLI, "Cliente", "Comitente de la obra.")
Person(TES, "Finanzas y Tesorería", "Opera dentro del ERP.")

System_Ext(erp, "Sistema ERP", "Motor financiero y documental.")
System_Boundary(obra, "Obra Studio") {
  Container(web, "Aplicación Web", "React + TypeScript", "Formularios de carga, medición y certificación.")
  Container(ecms, "Motor ECMS", "TypeScript", "Reglas de obra, presupuesto, medición y certificación.")
  ContainerDb(bd, "Base de Datos", "PostgreSQL", "Obras, presupuestos, mediciones y certificados.")
  ContainerDb(archivos, "Almacén de Archivos", "Almacenamiento de objetos", "Planillas de origen, evidencias y certificados exportados.")
}

Rel(ING, web, "Carga el presupuesto, registra la medición oficial y emite certificados", "HTTPS")
Rel(SUP, web, "Aprueba mediciones y cierra el período", "HTTPS")
Rel(ADM, web, "Activa versiones, emite certificados y aprueba movimientos presupuestarios", "HTTPS")
Rel(SUB, web, "Consulta el estado de su contrato", "HTTPS")
Rel(TES, web, "Aprueba y ejecuta pagos y registra cobros", "HTTPS")
Rel(web, ecms, "Invoca los casos de uso", "HTTPS/JSON")
Rel(ecms, bd, "Lee y escribe", "SQL")
Rel(ecms, archivos, "Conserva planillas, evidencias y exportaciones", "API de objetos")
Rel(ecms, erp, "Publica el certificado emitido", "Evento de dominio")
@enduml
