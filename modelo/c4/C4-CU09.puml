@startuml
!include <C4/C4_Dynamic>
LAYOUT_WITH_LEGEND()
title CU-09 — Emitir certificado de avance

Container(web, "Aplicación Web", "React + TypeScript", "Interfaz de usuario.")
Component(EmitirCertificadoControlador, "EmitirCertificadoControlador", "Controller / Presenter")
Component(EmitirCertificadoInteractor, "EmitirCertificadoInteractor", "Interactor")
Component(CalcularValorizacionServicio, "CalcularValorizacionServicio", "Interactor")
Component(Certificado, "Certificado", "Entidad de dominio")
Component(ICertificadoRepositorio, "ICertificadoRepositorio", "Interfaz")
Component(IGeneradorDocumento, "IGeneradorDocumento", "Interfaz")
Component(IPublicadorEventos, "IPublicadorEventos", "Interfaz")

Rel(web, EmitirCertificadoControlador, "1. abrirRevision(revisionId)")
Rel(EmitirCertificadoControlador, EmitirCertificadoInteractor, "2. obtenerRevision(revisionId)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "3. buscarRevision(revisionId)")
Rel(EmitirCertificadoInteractor, CalcularValorizacionServicio, "4. calcular(lineas, configuracionObra)")
Rel(web, EmitirCertificadoControlador, "5. emitirCertificado(revisionId, destinatario)")
Rel(EmitirCertificadoControlador, EmitirCertificadoInteractor, "6. emitir(revisionId, destinatario, actorId)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "7. siguienteNumero(obraId)")
Rel(EmitirCertificadoInteractor, Certificado, "8. emitir(numero, fecha, destinatario, actorId)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "9. guardar(certificado)")
Rel(EmitirCertificadoInteractor, IGeneradorDocumento, "10. exportar(revision, formato)")
Rel(EmitirCertificadoInteractor, IPublicadorEventos, "11. publicar(CertificadoEmitido(certificadoId))")
@enduml
