@startuml
!include <C4/C4_Dynamic>
LAYOUT_WITH_LEGEND()
title CU-09 — Emitir certificado de avance

Container(web, "Aplicación Web", "React + TypeScript", "Interfaz de usuario.")
Component(EmitirCertificadoControlador, "EmitirCertificadoControlador", "Controller / Presenter")
Component(EmitirCertificadoInteractor, "EmitirCertificadoInteractor", "Interactor")
Component(VerificarSeparacionFuncionesServicio, "VerificarSeparacionFuncionesServicio", "Interactor")
Component(CalcularValorizacionServicio, "CalcularValorizacionServicio", "Interactor")
Component(Certificado, "Certificado", "Entidad de dominio")
Component(RevisionCertificado, "RevisionCertificado", "Entidad de dominio")
Component(Aprobacion, "Aprobacion", "Entidad de dominio")
Component(ICertificadoRepositorio, "ICertificadoRepositorio", "Interfaz")
Component(IGeneradorDocumento, "IGeneradorDocumento", "Interfaz")
Component(IPublicadorEventos, "IPublicadorEventos", "Interfaz")

Rel(web, EmitirCertificadoControlador, "1. abrirRevision(revisionId)")
Rel(EmitirCertificadoControlador, EmitirCertificadoInteractor, "2. obtenerRevision(revisionId)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "3. buscarRevision(revisionId)")
Rel(EmitirCertificadoInteractor, CalcularValorizacionServicio, "4. calcular(lineas, configuracionObra)")
Rel(web, EmitirCertificadoControlador, "5. otorgarConformidadTecnica(revisionId)")
Rel(EmitirCertificadoControlador, EmitirCertificadoInteractor, "6. registrarAprobacion(revisionId, actorId, CONFORMIDAD_TECNICA)")
Rel(EmitirCertificadoInteractor, Aprobacion, "7. crear(tipo, actorId, fecha)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "8. guardar(revision)")
Rel(web, EmitirCertificadoControlador, "9. autorizarEmision(revisionId)")
Rel(EmitirCertificadoControlador, EmitirCertificadoInteractor, "10. emitir(revisionId, actorId)")
Rel(EmitirCertificadoInteractor, RevisionCertificado, "11. aprobaciones()")
Rel(EmitirCertificadoInteractor, VerificarSeparacionFuncionesServicio, "12. verificar(aprobaciones, actorId)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "13. siguienteNumero(obraId)")
Rel(EmitirCertificadoInteractor, Certificado, "14. aprobar(numero, fecha, destinatario)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "15. guardar(certificado)")
Rel(EmitirCertificadoInteractor, IGeneradorDocumento, "16. exportar(revision, formato)")
Rel(EmitirCertificadoInteractor, IPublicadorEventos, "17. publicar(CertificadoAprobado(certificadoId))")
@enduml
