@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Componentes — capas de Clean Architecture en el Motor ECMS
Container(web, "Aplicación Web", "React + TypeScript", "Interfaz de usuario.")
ContainerDb(bd, "Base de Datos", "PostgreSQL", "Datos del sistema.")
ContainerDb(archivos, "Almacén de Archivos", "Almacenamiento de objetos", "Planillas y evidencias.")
System_Ext(erp, "Sistema ERP", "Motor financiero y documental.")
Container_Boundary(ecms, "Motor ECMS") {
  Boundary(boundary_b, "Adaptadores de interfaz") {
    Component(ImportarPresupuestoControlador, "ImportarPresupuestoControlador", "Controller / Presenter")
    Component(ImportacionPresentador, "ImportacionPresentador", "Controller / Presenter")
    Component(AprobarMedicionControlador, "AprobarMedicionControlador", "Controller / Presenter")
    Component(MedicionPresentador, "MedicionPresentador", "Controller / Presenter")
    Component(EmitirCertificadoControlador, "EmitirCertificadoControlador", "Controller / Presenter")
    Component(CertificadoPresentador, "CertificadoPresentador", "Controller / Presenter")
  }
  Boundary(control_b, "Casos de uso") {
    Component(ImportarPresupuestoInteractor, "ImportarPresupuestoInteractor", "Interactor")
    Component(ValidarEstructuraServicio, "ValidarEstructuraServicio", "Interactor")
    Component(ContrastarTotalesServicio, "ContrastarTotalesServicio", "Interactor")
    Component(AprobarMedicionInteractor, "AprobarMedicionInteractor", "Interactor")
    Component(EvaluarSaldoServicio, "EvaluarSaldoServicio", "Interactor")
    Component(EmitirCertificadoInteractor, "EmitirCertificadoInteractor", "Interactor")
    Component(VerificarSeparacionFuncionesServicio, "VerificarSeparacionFuncionesServicio", "Interactor")
    Component(CalcularValorizacionServicio, "CalcularValorizacionServicio", "Interactor")
  }
  Boundary(entity_b, "Dominio: entidades") {
    Component(Obra, "Obra", "Entidad de dominio")
    Component(Presupuesto, "Presupuesto", "Entidad de dominio")
    Component(VersionPresupuesto, "VersionPresupuesto", "Entidad de dominio")
    Component(LineaPresupuesto, "LineaPresupuesto", "Entidad de dominio")
    Component(ArchivoOrigen, "ArchivoOrigen", "Entidad de dominio")
    Component(InformeImportacion, "InformeImportacion", "Entidad de dominio")
    Component(Periodo, "Periodo", "Entidad de dominio")
    Component(MedicionOficial, "MedicionOficial", "Entidad de dominio")
    Component(Evidencia, "Evidencia", "Entidad de dominio")
    Component(PropuestaPendiente, "PropuestaPendiente", "Entidad de dominio")
    Component(Certificado, "Certificado", "Entidad de dominio")
    Component(RevisionCertificado, "RevisionCertificado", "Entidad de dominio")
    Component(LineaCertificado, "LineaCertificado", "Entidad de dominio")
    Component(Aprobacion, "Aprobacion", "Entidad de dominio")
    Component(RetencionAplicada, "RetencionAplicada", "Entidad de dominio")
    Component(ConfiguracionObra, "ConfiguracionObra", "Entidad de dominio")
    Component(FondoRetencion, "FondoRetencion", "Entidad de dominio")
    Component(Valorizacion, "Valorizacion", "Entidad de dominio")
  }
  Boundary(puertos_b, "Dominio: puertos") {
    Component(IPresupuestoRepositorio, "IPresupuestoRepositorio", "Interfaz")
    Component(IAlmacenArchivos, "IAlmacenArchivos", "Interfaz")
    Component(ILectorPlanilla, "ILectorPlanilla", "Interfaz")
    Component(IAuditoriaRepositorio, "IAuditoriaRepositorio", "Interfaz")
    Component(IMedicionRepositorio, "IMedicionRepositorio", "Interfaz")
    Component(IReloj, "IReloj", "Interfaz")
    Component(ICertificadoRepositorio, "ICertificadoRepositorio", "Interfaz")
    Component(IGeneradorDocumento, "IGeneradorDocumento", "Interfaz")
    Component(IPublicadorEventos, "IPublicadorEventos", "Interfaz")
  }
  Boundary(adapter_b, "Infraestructura") {
    Component(PresupuestoRepositorioSQL, "PresupuestoRepositorioSQL", "Adaptador")
    Component(AlmacenArchivosS3, "AlmacenArchivosS3", "Adaptador")
    Component(LectorPlanillaXLSX, "LectorPlanillaXLSX", "Adaptador")
    Component(AuditoriaRepositorioSQL, "AuditoriaRepositorioSQL", "Adaptador")
    Component(MedicionRepositorioSQL, "MedicionRepositorioSQL", "Adaptador")
    Component(RelojSistema, "RelojSistema", "Adaptador")
    Component(CertificadoRepositorioSQL, "CertificadoRepositorioSQL", "Adaptador")
    Component(GeneradorDocumentoXLSXPDF, "GeneradorDocumentoXLSXPDF", "Adaptador")
    Component(PuenteERP, "PuenteERP", "Adaptador")
  }
}
Rel(web, ImportarPresupuestoControlador, "importarPresupuesto(obraId, archivo)")
Rel(ImportarPresupuestoControlador, ImportarPresupuestoInteractor, "ejecutar(solicitudImportacion)")
Rel(ImportarPresupuestoInteractor, IAlmacenArchivos, "guardar(archivo)")
Rel(ImportarPresupuestoInteractor, IPresupuestoRepositorio, "buscarPorHash(hashSHA256)")
Rel(ImportarPresupuestoInteractor, ILectorPlanilla, "leer(archivo)")
Rel(ImportarPresupuestoInteractor, LineaPresupuesto, "crear(codigo, unidad, cantidad, precioUnitario)")
Rel(ImportarPresupuestoInteractor, ValidarEstructuraServicio, "validar(lineas)")
Rel(ImportarPresupuestoInteractor, ContrastarTotalesServicio, "contrastar(totalDeclarado, totalRecalculado)")
Rel(ImportarPresupuestoInteractor, VersionPresupuesto, "crear(numero, estado = Propuesta)")
Rel(web, AprobarMedicionControlador, "listarMediciones(obraId, periodoId)")
Rel(AprobarMedicionControlador, AprobarMedicionInteractor, "obtenerPendientes(periodoId)")
Rel(AprobarMedicionInteractor, IMedicionRepositorio, "listarPorPeriodo(periodoId)")
Rel(AprobarMedicionInteractor, IPresupuestoRepositorio, "buscarVersionVigente(obraId)")
Rel(AprobarMedicionInteractor, LineaPresupuesto, "saldo(cantidadAcumulada)")
Rel(AprobarMedicionInteractor, EvaluarSaldoServicio, "evaluar(cantidadMedida, saldo)")
Rel(AprobarMedicionInteractor, PropuestaPendiente, "crear(exceso, estado = Pendiente)")
Rel(AprobarMedicionInteractor, MedicionOficial, "aprobar(cantidadCertificable, actorId, fecha)")
Rel(AprobarMedicionInteractor, IAuditoriaRepositorio, "registrar(actor, fecha, obra, version, decisión)")
Rel(web, EmitirCertificadoControlador, "abrirRevision(revisionId)")
Rel(EmitirCertificadoControlador, EmitirCertificadoInteractor, "obtenerRevision(revisionId)")
Rel(EmitirCertificadoInteractor, ICertificadoRepositorio, "buscarRevision(revisionId)")
Rel(EmitirCertificadoInteractor, CalcularValorizacionServicio, "calcular(lineas, configuracionObra)")
Rel(EmitirCertificadoInteractor, Aprobacion, "crear(tipo, actorId, fecha)")
Rel(EmitirCertificadoInteractor, RevisionCertificado, "aprobaciones()")
Rel(EmitirCertificadoInteractor, VerificarSeparacionFuncionesServicio, "verificar(aprobaciones, actorId)")
Rel(EmitirCertificadoInteractor, Certificado, "aprobar(numero, fecha, destinatario)")
Rel(EmitirCertificadoInteractor, IGeneradorDocumento, "exportar(revision, formato)")
Rel(EmitirCertificadoInteractor, IPublicadorEventos, "publicar(CertificadoAprobado(certificadoId))")
Rel(PresupuestoRepositorioSQL, IPresupuestoRepositorio, "Implementa")
Rel(AlmacenArchivosS3, IAlmacenArchivos, "Implementa")
Rel(LectorPlanillaXLSX, ILectorPlanilla, "Implementa")
Rel(AuditoriaRepositorioSQL, IAuditoriaRepositorio, "Implementa")
Rel(MedicionRepositorioSQL, IMedicionRepositorio, "Implementa")
Rel(RelojSistema, IReloj, "Implementa")
Rel(CertificadoRepositorioSQL, ICertificadoRepositorio, "Implementa")
Rel(GeneradorDocumentoXLSXPDF, IGeneradorDocumento, "Implementa")
Rel(PuenteERP, IPublicadorEventos, "Implementa")
@enduml
