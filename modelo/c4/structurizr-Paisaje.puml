@startuml
title <size:24>System Landscape View</size>\n<size:24>Obra Studio, el ERP y las personas que intervienen.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #0b5394;
    LineColor: #073a67;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Externo
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw== {
    BackgroundColor: #8c8c8c;
    LineColor: #626262;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
</style>

person "==Ingeniero de Obra\n<size:16>[Person]</size>\n\nCarga el presupuesto y el cronograma de la obra, registra la medición oficial de cada ítem del período con su evidencia y corrige los borradores devueltos." <<Element-RWxlbWVudCxQZXJzb24=>> as IngenierodeObra
person "==Responsable Técnico\n<size:16>[Person]</size>\n\nSupervisor de la obra." <<Element-RWxlbWVudCxQZXJzb24=>> as ResponsableTécnico
person "==Administrador\n<size:16>[Person]</size>\n\nConfigura la obra, sus impuestos y sus fondos de retención, autoriza la emisión del certificado sobre la revisión ya conformada, aprueba los movimientos presupuestarios y habilita la reapertura auditada." <<Element-RWxlbWVudCxQZXJzb24=>> as Administrador
person "==Subcontratista\n<size:16>[Person]</size>\n\nPresenta las mediciones correspondientes a su contrato y consulta el estado de sus mediciones, certificados y saldos." <<Element-RWxlbWVudCxQZXJzb24=>> as Subcontratista
person "==Cliente\n<size:16>[Person]</size>\n\nComitente de la obra." <<Element-RWxlbWVudCxQZXJzb24=>> as Cliente
person "==Finanzas y Tesorería\n<size:16>[Person]</size>\n\nOpera dentro del ERP." <<Element-RWxlbWVudCxQZXJzb24=>> as FinanzasyTesorería
rectangle "==Sistema ERP\n<size:16>[Software System]</size>\n\nMotor financiero y documental. Registra lo que el ECMS midió y certificó." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as SistemaERP
rectangle "==Obra Studio\n<size:16>[Software System]</size>\n\nGestiona presupuesto, medición, certificación y costos de obra." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ObraStudio

IngenierodeObra --> ObraStudio <<Relationship-UmVsYXRpb25zaGlw>> : "Carga el presupuesto y registra la medición oficial\n<size:16>[HTTPS]</size>"
ResponsableTécnico --> ObraStudio <<Relationship-UmVsYXRpb25zaGlw>> : "Aprueba mediciones y otorga la conformidad técnica\n<size:16>[HTTPS]</size>"
Administrador --> ObraStudio <<Relationship-UmVsYXRpb25zaGlw>> : "Autoriza la emisión y aprueba movimientos presupuestarios\n<size:16>[HTTPS]</size>"
Subcontratista --> ObraStudio <<Relationship-UmVsYXRpb25zaGlw>> : "Presenta las mediciones de su contrato\n<size:16>[HTTPS]</size>"
ObraStudio --> SistemaERP <<Relationship-UmVsYXRpb25zaGlw>> : "Publica el certificado aprobado para su documento financiero\n<size:16>[Evento de dominio]</size>"
SistemaERP --> Cliente <<Relationship-UmVsYXRpb25zaGlw>> : "Emite la factura del certificado\n<size:16>[Documento]</size>"
SistemaERP --> FinanzasyTesorería <<Relationship-UmVsYXRpb25zaGlw>> : "Registra el cobro o el pago\n<size:16>[Documento]</size>"

@enduml