@startuml
!include <C4/C4_Dynamic>
LAYOUT_WITH_LEGEND()
title CU-02 — Importar presupuesto y cronograma

Container(web, "Aplicación Web", "React + TypeScript", "Interfaz de usuario.")
Component(ImportarPresupuestoControlador, "ImportarPresupuestoControlador", "Controller / Presenter")
Component(ImportarPresupuestoInteractor, "ImportarPresupuestoInteractor", "Interactor")
Component(ValidarEstructuraServicio, "ValidarEstructuraServicio", "Interactor")
Component(ContrastarTotalesServicio, "ContrastarTotalesServicio", "Interactor")
Component(VersionPresupuesto, "VersionPresupuesto", "Entidad de dominio")
Component(LineaPresupuesto, "LineaPresupuesto", "Entidad de dominio")
Component(IPresupuestoRepositorio, "IPresupuestoRepositorio", "Interfaz")
Component(IAlmacenArchivos, "IAlmacenArchivos", "Interfaz")
Component(ILectorPlanilla, "ILectorPlanilla", "Interfaz")

Rel(web, ImportarPresupuestoControlador, "1. importarPresupuesto(obraId, archivo)")
Rel(ImportarPresupuestoControlador, ImportarPresupuestoInteractor, "2. ejecutar(solicitudImportacion)")
Rel(ImportarPresupuestoInteractor, IAlmacenArchivos, "3. guardar(archivo)")
Rel(ImportarPresupuestoInteractor, IPresupuestoRepositorio, "4. buscarPorHash(hashSHA256)")
Rel(ImportarPresupuestoInteractor, ILectorPlanilla, "5. leer(archivo)")
Rel(ImportarPresupuestoInteractor, LineaPresupuesto, "6. crear(codigo, unidad, cantidad, precioUnitario)")
Rel(ImportarPresupuestoInteractor, ValidarEstructuraServicio, "7. validar(lineas)")
Rel(ImportarPresupuestoInteractor, ContrastarTotalesServicio, "8. contrastar(totalDeclarado, totalRecalculado)")
Rel(web, ImportarPresupuestoControlador, "9. confirmarImportacion(solicitudId)")
Rel(ImportarPresupuestoControlador, ImportarPresupuestoInteractor, "10. confirmar(solicitudId)")
Rel(ImportarPresupuestoInteractor, VersionPresupuesto, "11. crear(numero, estado = Propuesta)")
Rel(ImportarPresupuestoInteractor, IPresupuestoRepositorio, "12. guardarVersion(version)")
@enduml
