@startuml
!include <C4/C4_Dynamic>
LAYOUT_WITH_LEGEND()
title CU-11 — Proponer y aprobar movimiento presupuestario

Container(web, "Aplicación Web", "React + TypeScript", "Interfaz de usuario.")
Component(MovimientoControlador, "MovimientoControlador", "Controller / Presenter")
Component(MovimientoInteractor, "MovimientoInteractor", "Interactor")
Component(EvaluarLimiteServicio, "EvaluarLimiteServicio", "Interactor")
Component(VersionPresupuesto, "VersionPresupuesto", "Entidad de dominio")
Component(MovimientoPresupuestario, "MovimientoPresupuestario", "Entidad de dominio")
Component(IAuditoriaRepositorio, "IAuditoriaRepositorio", "Interfaz")
Component(IPresupuestoRepositorio, "IPresupuestoRepositorio", "Interfaz")
Component(IAlmacenArchivos, "IAlmacenArchivos", "Interfaz")
Component(IMovimientoRepositorio, "IMovimientoRepositorio", "Interfaz")

Rel(web, MovimientoControlador, "1. proponerMovimiento(obraId, objetivoId)")
Rel(MovimientoControlador, MovimientoInteractor, "2. prepararPropuesta(objetivoId)")
Rel(MovimientoInteractor, IPresupuestoRepositorio, "3. buscarVersionVigente(obraId)")
Rel(web, MovimientoControlador, "4. registrarPropuesta(causa, tipo, objetivoId, cantidad, precio, motivo, respaldo)")
Rel(MovimientoControlador, MovimientoInteractor, "5. proponer(solicitudMovimiento, actorId)")
Rel(MovimientoInteractor, IAlmacenArchivos, "6. guardar(respaldo)")
Rel(MovimientoInteractor, EvaluarLimiteServicio, "7. evaluar(tipo, cantidad, precio, saldoVigente)")
Rel(MovimientoInteractor, MovimientoPresupuestario, "8. crear(tipo, motivo, montoEfecto, limite, estado = Propuesto)")
Rel(MovimientoInteractor, IMovimientoRepositorio, "9. guardar(movimiento)")
Rel(web, MovimientoControlador, "10. aprobarInterno(movimientoId)")
Rel(MovimientoControlador, MovimientoInteractor, "11. aprobarInterno(movimientoId, actorId)")
Rel(MovimientoInteractor, IMovimientoRepositorio, "12. buscar(movimientoId)")
Rel(MovimientoInteractor, MovimientoPresupuestario, "13. aprobarInterno(actorId, fecha)")
Rel(MovimientoInteractor, IMovimientoRepositorio, "14. guardar(movimiento)")
Rel(web, MovimientoControlador, "15. registrarAprobacionContractual(movimientoId, respaldoCliente)")
Rel(MovimientoControlador, MovimientoInteractor, "16. aprobarContractual(movimientoId, actorId)")
Rel(MovimientoInteractor, MovimientoPresupuestario, "17. aprobarContractual(actorId, fecha, respaldoCliente)")
Rel(MovimientoInteractor, IMovimientoRepositorio, "18. guardar(movimiento)")
Rel(web, MovimientoControlador, "19. activarMovimiento(movimientoId)")
Rel(MovimientoControlador, MovimientoInteractor, "20. activar(movimientoId, actorId)")
Rel(MovimientoInteractor, VersionPresupuesto, "21. crear(numero siguiente, líneas con el movimiento)")
Rel(MovimientoInteractor, VersionPresupuesto, "22. activar(fecha)")
Rel(MovimientoInteractor, VersionPresupuesto, "23. reemplazar()")
Rel(MovimientoInteractor, MovimientoPresupuestario, "24. activar(versionId)")
Rel(MovimientoInteractor, MovimientoPresupuestario, "25. cubrirPropuestasPendientes()")
Rel(MovimientoInteractor, IPresupuestoRepositorio, "26. guardarVersion(version)")
Rel(MovimientoInteractor, IMovimientoRepositorio, "27. guardar(movimiento)")
Rel(MovimientoInteractor, IAuditoriaRepositorio, "28. registrar(actor, fecha, obra, version, movimiento)")
@enduml
